# ---------------------------------------------------------------------------
# Personal data (generated at runtime)
# ---------------------------------------------------------------------------
# These hold real financial records and must never be committed.
finance.db
finance.db-wal
finance.db-shm
*.db
transactions.csv
recurring.csv
budgets.csv
accounts.csv

# Exports can be named anything, so no list of filenames is enough. The repo
# tracks no CSVs, so ignoring all of them costs nothing and stops financial
# data reaching a commit by accident.
*.csv

# Keep sample/template data if you ever add it, e.g.:
# !transactions.example.csv

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
MANIFEST

# Unit tests / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache

# Type checkers / linters
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

